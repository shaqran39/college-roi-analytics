# Template. Copy to secrets.toml and fill in. Committed on purpose: values are blank.

# Uploading a CSV on the Auto insights page (leave both blank to switch uploading off).
# These two lines must stay ABOVE the [databricks] section, or TOML puts them inside it.
upload_password = ""          # a long password only you know; anyone with it can upload
databricks_upload_token = ""  # the upload-only token (service principal, "files" scope), NOT the token below

# Paste the values from your Databricks SQL warehouse (Connection details tab).
[databricks]
host = ""          # e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com (no https://)
http_path = ""     # e.g. /sql/1.0/warehouses/xxxxxxxxxxxxxxxx
token = ""         # a personal access token made just for the dashboard
